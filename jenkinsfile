pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'Main',
                    url: 'https://github.com/sagar12345raikwar-stack/pipeline-ci-demo.git'
            }
        }

        stage('Build Application') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Package Application') {
            steps {
                sh 'mvn package'
            }
        }
    }

    post {
        success {
            echo 'Build Successful!'
        }

        failure {
            echo 'Build Failed!'
        }
    }
}
