pipeline {
    agent any

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'Main',
                    url: 'https://github.com/sagar12345raikwar-stack/pipeline-ci-demo.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Parallel Checks') {
            parallel {

                stage('Unit Test') {
                    steps {
                        sh 'mvn test'
                    }
                }

                stage('Code Quality') {
                    steps {
                        echo 'Running Code Quality Checks'
                        sh 'mvn checkstyle:check || true'
                    }
                }

                stage('Security Scan') {
                    steps {
                        echo 'Running Security Scan'
                        sh 'mvn dependency-check:check || true'
                    }
                }
            }
        }

        stage('Package') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
